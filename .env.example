# 개인 PC에서 쓰는 값의 예시. 실제 값은 .env.local 에 둔다 (저장소에 올리지 않음).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hr_eval
# 인증번호·세션 해시에 섞는 비밀값 (32자 이상 무작위)
AUTH_SECRET=change-me-to-a-long-random-string-32chars
# 서비스 주소 (메일 링크에 들어감)
APP_URL=http://localhost:3000
# 메일: log = 실제로 보내지 않고 기록만 / smtp = 다우오피스로 발송
MAIL_MODE=log
MAIL_FROM="파워넷 인사평가 <hr-eval@example.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 개발용에서 실제로 보내도 되는 주소 (쉼표로 구분). 비어 있으면 아무에게도 안 보냄
MAIL_ALLOWLIST=
# 예약 실행 주소를 보호하는 비밀값
CRON_SECRET=change-me
