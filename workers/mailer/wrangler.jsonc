{
  // 발송 전용 Worker. 배포: cd workers/mailer && npx wrangler deploy
  // 비밀값: SMTP_HOST·SMTP_PORT·SMTP_USER·SMTP_PASS·MAIL_FROM·CRON_SECRET → wrangler secret put
  "name": "hr-eval-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "services": [{ "binding": "APP", "service": "hr-eval" }],
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    // 처음 한 번만: 본 프로그램(hr-eval)이 아직 없을 때 서로 가리키는 연결 없이 먼저 올린다 (scripts/deploy-cf.sh)
    "bootstrap": { "name": "hr-eval-mailer", "services": [], "triggers": { "crons": [] } }
  }
}
